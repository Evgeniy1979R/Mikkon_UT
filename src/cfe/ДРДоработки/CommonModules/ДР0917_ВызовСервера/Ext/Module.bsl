Функция СоздатьСерию(Знач Номер,Номенклатура) Экспорт
	Номер = СтрЗаменить(Номер,"{CSP}","");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПроизводства",НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Свойство_ДатаПервогоВзвешивания",ДР0917_СерверПовторноеИспользование.Свойство_ДатаПервогоВзвешивания());
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(СерииНоменклатурыДополнительныеРеквизиты.Ссылка) КАК Ссылка
	|ИЗ
	|	Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииНоменклатурыДополнительныеРеквизиты
	|ГДЕ
	|	СерииНоменклатурыДополнительныеРеквизиты.Свойство = &Свойство_ДатаПервогоВзвешивания
	|	И СерииНоменклатурыДополнительныеРеквизиты.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И СерииНоменклатурыДополнительныеРеквизиты.Значение В
	|			(ВЫБРАТЬ
	|				МАКСИМУМ(ВЫРАЗИТЬ(СерииНоменклатурыДополнительныеРеквизиты.Значение КАК ДАТА)) КАК Поле1
	|			ИЗ
	|				Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииНоменклатурыДополнительныеРеквизиты
	|			ГДЕ
	|				СерииНоменклатурыДополнительныеРеквизиты.Свойство = &Свойство_ДатаПервогоВзвешивания
	|				И СерииНоменклатурыДополнительныеРеквизиты.Ссылка.ПометкаУдаления = ЛОЖЬ
	|				И СерииНоменклатурыДополнительныеРеквизиты.Ссылка.ДатаПроизводства = &ДатаПроизводства)";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.Ссылка = Null Тогда 
		СсылкаНаСерию = Справочники.СерииНоменклатуры.ПустаяСсылка();
	Иначе
		СсылкаНаСерию = Выборка.Ссылка;
	КонецЕсли;
	
	тСвойстваПредыдущейСерии = УправлениеСвойствами.ЗначенияСвойств(СсылкаНаСерию,Истина,Ложь,Неопределено);
	РеквиитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура,"СрокГодности,ЕдиницаИзмеренияСрокаГодности,ВидНоменклатуры",Истина);
	оСерия = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	оСерия.ДатаПроизводства=НачалоДня(ТекущаяДата());
	оСерия.ГоденДо = НоменклатураКлиентСервер.ГоденДоПоДатеПроизводства(оСерия.ДатаПроизводства, РеквиитыНоменклатуры.СрокГодности, РеквиитыНоменклатуры.ЕдиницаИзмеренияСрокаГодности);
	оСерия.ВидНоменклатуры=РеквиитыНоменклатуры.ВидНоменклатуры;
	оСерия.Номер=Номер; 
	ПорядковыйНомер = "001А";
	тСвойстваСериия = оСерия.ДополнительныеРеквизиты;
	Для Каждого сСвойстваПредыдущейСерии из тСвойстваПредыдущейСерии Цикл
		Если сСвойстваПредыдущейСерии.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_ПорядковыйНомер() Тогда 
			ПорядковыйНомер = СформироватьСледующийНомер(сСвойстваПредыдущейСерии.Значение);
		ИначеЕсли сСвойстваПредыдущейСерии.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_ПредставительХозяйства() 
			или сСвойстваПредыдущейСерии.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_Хозяйство() Тогда 
			сСвойстваСерия = тСвойстваСериия.Добавить();
			ЗаполнитьЗначенияСвойств(сСвойстваСерия,сСвойстваПредыдущейСерии);			
		КонецЕсли;
	КонецЦикла;
	сСвойстваСерия = тСвойстваСериия.Добавить();
	сСвойстваСерия.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_ДатаПервогоВзвешивания();
	сСвойстваСерия.Значение = ТекущаяДата();
	
	сСвойстваСерия = тСвойстваСериия.Добавить();
	сСвойстваСерия.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_ПорядковыйНомер();
	сСвойстваСерия.Значение = ПорядковыйНомер;
	оСерия.Записать();
	Возврат оСерия.Ссылка;
	
	
	
КонецФункции

Функция СформироватьСледующийНомер(Значение)
	Номер = Число(Лев(Значение,3));
	Сторона = Сред(Значение,4,1);
	Если Сторона = "А" Тогда // русская буква А
		Сторона = "Б";
	Иначе
		Сторона = "А";
		Номер = Номер + 1;
	КонецЕсли;
	Возврат СтрШаблон("%1%2",Формат(Номер,"ЧЦ=3; ЧН=000; ЧВН=; ЧГ=0"),Сторона);
	
КонецФункции

Функция ПолучитьСерию(Знач Номер,Номенклатура) Экспорт
	Номер = СтрЗаменить(Номер,"{CSP}","");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Свойство_ДатаВторогоВзвешивания",ДР0917_СерверПовторноеИспользование.Свойство_ДатаВторогоВзвешивания());
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СерииНоменклатуры.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(СерииНоменклатурыДополнительныеРеквизиты.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВторогоВзвешивания
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииНоменклатурыДополнительныеРеквизиты
	|		ПО СерииНоменклатуры.Ссылка = СерииНоменклатурыДополнительныеРеквизиты.Ссылка
	|			И (&Свойство_ДатаВторогоВзвешивания = СерииНоменклатурыДополнительныеРеквизиты.Свойство)
	|ГДЕ
	|	СерииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И СерииНоменклатуры.Номер = &Номер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВторогоВзвешивания";
	Выборка = Запрос.Выполнить().Выбрать();
	Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
	ДатаВторогоВзвешивания = '00010101';
	Если Выборка.Следующий() Тогда
		Серия = Выборка.Ссылка;
		ДатаВторогоВзвешивания = Выборка.ДатаВторогоВзвешивания;
	КонецЕсли;
	Если Серия.Пустая() = Ложь и ДатаВторогоВзвешивания = '00010101' Тогда 
		оСерия = Серия.ПолучитьОбъект();
		тСвойстваСериия = оСерия.ДополнительныеРеквизиты;
		сСвойства = тСвойстваСериия.Найти(ДР0917_СерверПовторноеИспользование.Свойство_ДатаВторогоВзвешивания(),"Свойство");
		Если сСвойства = Неопределено Тогда 
			сСвойства = тСвойстваСериия.Добавить();
			сСвойства.Свойство = ДР0917_СерверПовторноеИспользование.Свойство_ДатаВторогоВзвешивания();
		КонецЕсли;
		сСвойства.Значение = ТекущаяДата();
		оСерия.Записать();
	КонецЕсли;
	
	
	Возврат Серия;
	
	
	
КонецФункции

Функция ПолучитьДанныеСерии(Знач Номер) Экспорт
	
	Результат = Новый Структура("Серия,ДатаПервогоВзвешивания,ДатаВторогоВзвешивания",Справочники.СерииНоменклатуры.ПустаяСсылка(),'00010101','00010101' );
	
	Номер = СтрЗаменить(Номер,"{CSP}","");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Свойство_ДатаВторогоВзвешивания",ДР0917_СерверПовторноеИспользование.Свойство_ДатаВторогоВзвешивания());
	Запрос.УстановитьПараметр("Свойство_ДатаПервогоВзвешивания",ДР0917_СерверПовторноеИспользование.Свойство_ДатаПервогоВзвешивания());
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СерииНоменклатуры.Ссылка КАК Серия,
	               |	ЕСТЬNULL(СерииНоменклатурыДополнительныеРеквизиты_ДатаВторогоВзвешивания.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВторогоВзвешивания,
	               |	ЕСТЬNULL(СерииНоменклатурыДополнительныеРеквизиты_ДатаПервогоВзвешивания.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПервогоВзвешивания
	               |ИЗ
	               |	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииНоменклатурыДополнительныеРеквизиты_ДатаВторогоВзвешивания
	               |		ПО СерииНоменклатуры.Ссылка = СерииНоменклатурыДополнительныеРеквизиты_ДатаВторогоВзвешивания.Ссылка
	               |			И (&Свойство_ДатаВторогоВзвешивания = СерииНоменклатурыДополнительныеРеквизиты_ДатаВторогоВзвешивания.Свойство)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.ДополнительныеРеквизиты КАК СерииНоменклатурыДополнительныеРеквизиты_ДатаПервогоВзвешивания
	               |		ПО СерииНоменклатуры.Ссылка = СерииНоменклатурыДополнительныеРеквизиты_ДатаПервогоВзвешивания.Ссылка
	               |			И (&Свойство_ДатаПервогоВзвешивания = СерииНоменклатурыДополнительныеРеквизиты_ДатаПервогоВзвешивания.Свойство)
	               |ГДЕ
	               |	СерииНоменклатуры.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И СерииНоменклатуры.Номер = &Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаВторогоВзвешивания";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Результат,Выборка);
	КонецЕсли;
	
		Возврат Результат;
		
КонецФункции
