



// делаем несколько запросов в течении 5 секунд
// Возьмем средрее медианное значение
Функция   ПолучитьМассу(ИД_Весов = 0) Экспорт
	
	НастройкаПрокси = Неопределено;
	
	Сервер = Константы.ДР0917_АдресUniServerAUTO.Получить();
	Порт = Константы.ДР0917_ПортUniServerAUTO.Получить();
	ИспользоватьNTMLАутентификацию = Неопределено;
	ЗащищенноеСоединение = Неопределено;
	Таймаут = 30;
	Если 	ИД_Весов = 1 Тогда // Пост1
		ИмяМетода = Константы.ДР0917_МетодUniServerAUTOПост1.Получить();
	ИначеЕсли ИД_Весов = 2 Тогда 
		ИмяМетода = Константы.ДР0917_МетодUniServerAUTOПост2.Получить();
	Иначе
		ВызватьИсключение("Параметр ИД_Весов задан не верно.");
	КонецЕсли;
	ИмяПользователя = Константы.ДР0917_ЛогинUniServerAUTO.Получить();
	ПарольПользователя = Константы.ДР0917_ПарольUniServerAUTO.Получить();
	
	
	АутентификацияПользователь = Неопределено;
	АутентификацияПароль = Неопределено;
	
	СоединениеHTTP = Новый HTTPСоединение(Сервер, Порт, АутентификацияПользователь, АутентификацияПароль, НастройкаПрокси,Таймаут, ЗащищенноеСоединение);
	НовыйЗапрос = Новый HTTPЗапрос;
	НовыйЗапрос.АдресРесурса = СтрШаблон("/core/SendMsg?auth_password=%1&auth_user=%2&Name=%3",ИмяПользователя,ПарольПользователя,ИмяМетода);
	ВидЗапроса = "GET";
	ДатаОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах()+3000;
	МассивРезультатов = Новый Массив;
	Пока Истина Цикл
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(ВидЗапроса, НовыйЗапрос);
		МассивРезультатов.Добавить(ОтветHTTP.ПолучитьТелоКакСтроку());
		Если  ТекущаяУниверсальнаяДатаВМиллисекундах() > ДатаОкончания Тогда 
			Прервать;
		КонецЕсли;
	КонецЦикла;
	тЧисловыеЗначения = Новый ТаблицаЗначений;
	тЧисловыеЗначения.Колонки.Добавить("Значение",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)));
	Для Каждого эл из МассивРезультатов Цикл
		Значение = ПреобразоватьВЧисло(эл);
		Если Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		тЧисловыеЗначения.Добавить().Значение = Значение; 
		
	КонецЦикла;
	тЧисловыеЗначения.Сортировать("Значение");
	Количество = тЧисловыеЗначения.Количество();
	
	Если Количество = 0 Тогда 
		ВызватьИсключение("Не удалось получить вес.");
	КонецЕсли;
	
	ИндексСередины = Цел((Количество - 1) / 2);
	Если Количество%2 = 1 Тогда 
		Возврат тЧисловыеЗначения[ИндексСередины].Значение;
	Иначе
		Возврат (тЧисловыеЗначения[ИндексСередины].Значение+тЧисловыеЗначения[ИндексСередины+1].Значение)/2
	КонецЕсли;
	
КонецФункции 

Функция  ПреобразоватьВЧисло(Знач ЧислоСтрока, Ошибка = Ложь)
	
	Попытка
		
		_ЧислоСтрока			= СтрЗаменить(ЧислоСтрока,",",".");
		ДопустимыеСимволыЧисла	= "-0123456789.";
		СтрокаРезультат			="";
		Для НСимвола = 1 По СтрДлина(_ЧислоСтрока) Цикл
			Если СтрНайти(ДопустимыеСимволыЧисла,Сред(_ЧислоСтрока,НСимвола,1))> 0 Тогда
				СтрокаРезультат = СтрокаРезультат + Сред(_ЧислоСтрока,НСимвола,1);
			КонецЕсли;
		КонецЦикла;
		Результат				= ?(СтрокаРезультат = "",0,Число(СтрокаРезультат));
		
	Исключение
		
		Сообщить(СтрШаблон("Ошибка преобразования числа %1",ЧислоСтрока));
		Ошибка = Истина;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции //ПреобразоватьВЧисло